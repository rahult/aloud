{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aloud",
  "version": "0.1.0",
  "identifier": "com.aloud.app",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "targets": ["app", "dmg", "msi", "nsis", "deb"],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../server.mjs": "server.mjs",
      "../node_modules": "node_modules"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
